# Environment Configuration
ENV=dev                          # dev | test | uat | prod

# ServiceNow PDI Configuration
SERVICENOW_INSTANCE_URL=https://dev00000.service-now.com
SERVICENOW_INTEGRATION_USER=ai_integration_user
SERVICENOW_INTEGRATION_PASSWORD=PDI_Readonly_Pass_123!

# Microsoft Entra ID Authentication
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
AUTH_MODE=dev_bypass             # dev_bypass | entra_jwt (dev_bypass is strictly forbidden if ENV != dev)

# LLM Configuration
LLM_PROVIDER=mock                # mock | groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Persistence & Caching
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
REDIS_URL=redis://localhost:6379/0
